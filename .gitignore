# 本地凭证与生成物，勿提交
tools/.env.local
cloudfunctions/docsProxy/env.local.js
cloudfunctions/docsProxy/nul
*.local

# 微信开发者工具：个人偏好/上传私钥配置，禁止入库（公开仓库尤甚）
project.private.config.json
private.*.key
*.pem

# 依赖
node_modules/
cloudfunctions/*/node_modules/

# 微信小程序 npm 构建产物（由工具链生成，非源码）
miniprogram_npm/

# 构建/打包产物
dist/
build/
*.zip
*.tar.gz

# 日志
*.log
logs/

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 项目级 agent/记忆数据（不在源码管理范围）
.workbuddy/

# 数据备份（内测期每日生成，不入库）——仅忽略项目根目录的 backup/，
# 不能写成裸 backup/（会连带忽略 pages/backup/ 备份功能页面源码）
/backup/
# 清库脚本生成的全库快照（含真实姓名/工号，严禁入库）
tools/backup_*.json
# 每学期教师带班主数据（含真实姓名/工号/班级，严禁入库；仅保留脱敏模板）
tools/data/terms/*.json
!tools/data/terms/_template.json
# 导出的账号清单 Excel（含全部真实姓名/工号/班级，严禁入库）
tools/data/terms/账号清单_*.xlsx

# UI 渲染预览产物（tools/ui_preview.js / ui_all_preview.js 生成，Edge headless 截图）
output/

# Office/WPS 打开文件时生成的锁文件（~$ 开头），是垃圾文件，不要入库
~$*
