<view class="wk">
  <!-- ===== 物品头部 ===== -->
  <block wx:if="{{item}}">
    <view class="hero dt-hero">
      <view class="hero-grid"></view>
      <view class="hero-inner">
        <view class="dt-top">
          <view class="dt-ic">
            <image src="{{type === 'material' ? '/images/ic-box-w.png' : '/images/ic-tool-w.png'}}" mode="aspectFit"></image>
          </view>
          <view class="grow">
            <view class="hero-tag">{{type === 'material' ? '耗材' : '工具'}}</view>
            <view class="dt-name">{{item.name}}</view>
            <view class="dt-id">ID {{item.id}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="page page-has-bar">
    <block wx:if="{{type==='material' && item}}">
      <!-- 库存概览 -->
      <view class="tiles">
        <view class="tile tile-blue">
          <view class="tile-n">{{item.stock}}</view>
          <view class="tile-l">实时库存 ({{item.unit}})</view>
        </view>
        <view class="tile tile-cyan">
          <view class="tile-n">{{item.safe}}</view>
          <view class="tile-l">安全库存</view>
        </view>
        <view class="tile tile-green">
          <view class="tile-n tile-cat">{{item.cat}}</view>
          <view class="tile-l">分类</view>
        </view>
      </view>

      <!-- 详情 -->
      <view class="card mt-m">
        <view class="sec">
          <view class="sec-bar"></view>
          <view class="sec-t">物品档案</view>
        </view>
        <view class="kv"><text class="kv-k">物料 ID</text><text class="kv-v">{{item.id}}</text></view>
        <view class="kv"><text class="kv-k">名称</text><text class="kv-v">{{item.name}}</text></view>
        <view class="kv"><text class="kv-k">分类</text><text class="kv-v">{{item.cat}}</text></view>
        <view class="kv"><text class="kv-k">存放位置</text><text class="kv-v">{{item.loc}}</text></view>
        <view class="kv"><text class="kv-k">计量单位</text><text class="kv-v">{{item.unit}}</text></view>
      </view>

      <!-- 库存水位 -->
      <view class="card">
        <view class="row-between">
          <view class="title" style="margin-bottom:0">库存水位</view>
          <view class="pill {{lowStock ? 'red' : 'ok'}}">{{lowStock ? '低于安全库存' : '库存充足'}}</view>
        </view>
        <view class="bar"><view class="bar-in {{lowStock ? 'red' : ''}}" style="width:{{stockPct}}%"></view></view>
        <view class="tip" style="margin-bottom:0">当前 {{item.stock}} {{item.unit}} · 安全下限 {{item.safe}} {{item.unit}}</view>
      </view>
    </block>

    <block wx:elif="{{type==='tool' && item}}">
      <!-- 工具状态 -->
      <view class="card">
        <view class="sec">
          <view class="sec-bar"></view>
          <view class="sec-t">工具档案</view>
        </view>
        <view class="kv"><text class="kv-k">工具 ID</text><text class="kv-v">{{item.id}}</text></view>
        <view class="kv"><text class="kv-k">名称</text><text class="kv-v">{{item.name}}</text></view>
        <view class="kv"><text class="kv-k">出厂编号</text><text class="kv-v">{{item.sn}}</text></view>
        <view class="kv"><text class="kv-k">当前状态</text><text class="kv-v"><text class="pill {{item.status==='在库'?'ok':item.status==='借出'?'blue':'red'}}">{{item.status}}</text></text></view>
      </view>

      <view wx:if="{{item.borrower}}" class="card card-accent">
        <view class="row">
          <view class="list-ic"><image src="/images/ic-users-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="list-nm">{{item.borrower}}</view>
            <view class="list-sub">当前借用人</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="empty">
      <image class="empty-ic" src="/images/ic-search-s.png" mode="aspectFit"></image>
      <view>未找到物品</view>
      <view class="tip">请检查物品 ID 或重新扫描二维码</view>
    </view>
  </view>

  <!-- ===== 吸底操作条 ===== -->
  <view wx:if="{{item}}" class="dt-bar">
    <block wx:if="{{type==='material' && role==='student'}}">
      <button class="btn btn-primary btn-block" bindtap="requisition">申请领用</button>
    </block>
    <block wx:elif="{{type==='tool' && role==='student' && item.status==='在库'}}">
      <button class="btn btn-primary btn-block" bindtap="requestBorrow">申请借出</button>
    </block>
    <block wx:elif="{{type==='tool' && role!=='student' && item.status!=='在库'}}">
      <button class="btn btn-cyan btn-block" bindtap="returnTool">确认归还</button>
    </block>
    <block wx:elif="{{type==='tool' && role==='student' && item.status!=='在库'}}">
      <view class="dt-hint">
        <image src="/images/ic-clock-s.png" mode="aspectFit"></image>
        <text>该工具已借出，等待归还</text>
      </view>
    </block>
    <block wx:else>
      <view class="dt-hint">
        <image src="/images/ic-shield-s.png" mode="aspectFit"></image>
        <text>{{role === 'student' ? '仅查看，无操作权限' : '当前物品在库，无需操作'}}</text>
      </view>
    </block>
  </view>
</view>
