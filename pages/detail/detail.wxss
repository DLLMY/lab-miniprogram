/* 物品详情页样式 */
.dt-hero { padding: 40rpx 32rpx 44rpx; }
.dt-top { display: flex; align-items: center; }
.dt-ic {
  width: 112rpx; height: 112rpx;
  border-radius: 34rpx;
  margin-right: 26rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255, 255, 255, .10);
  border: 1rpx solid rgba(255, 255, 255, .16);
  flex-shrink: 0;
}
.dt-ic image { width: 56rpx; height: 56rpx; }
.dt-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 14rpx;
  letter-spacing: 1rpx;
}
.dt-id {
  font-size: 23rpx;
  color: rgba(255, 255, 255, .48);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* 分类瓦片：分类名可能较长，缩小字号单行显示 */
.tile-cat { font-size: 28rpx; padding-top: 8rpx; }

/* 吸底操作条 */.dt-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .92);
  border-top: 1rpx solid rgba(15, 35, 80, .06);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -6rpx 26rpx rgba(15, 35, 80, .06);
  z-index: 20;
}
.dt-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  gap: 12rpx;
}
.dt-hint image { width: 32rpx; height: 32rpx; opacity: .6; }
.dt-hint text { font-size: 25rpx; color: #94A3B8; }

/* ===== 申请弹层（数量 + 用途）===== */
.ap-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(9, 20, 45, .45);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}
.ap-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.ap-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.ap-title { flex: 1; font-size: 34rpx; font-weight: 700; color: #0F2350; }
.ap-close {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F1F5F9; border-radius: 50%;
}
.ap-close image { width: 26rpx; height: 26rpx; opacity: .55; }
.ap-sub { font-size: 24rpx; color: #94A3B8; margin-bottom: 32rpx; }
.ap-star { color: #DC2626; }
.ap-tags { display: flex; flex-wrap: wrap; margin: 0 -8rpx 18rpx; }
.ap-tag {
  margin: 0 8rpx 14rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #5A6B85;
  background: #F1F5F9;
  border-radius: 999rpx;
}
.ap-tag.on { background: rgba(43, 108, 255, .12); color: #2B6CFF; font-weight: 600; }

/* 数量步进器（与 io 页同规格，保持手感一致） */
.qty { display: flex; align-items: center; }
.qty-btn {
  width: 76rpx; height: 76rpx;
  border-radius: 22rpx;
  background: #F1F5F9;
  display: flex; align-items: center; justify-content: center;
}
.qty-btn image { width: 30rpx; height: 30rpx; opacity: .6; }
.qty-inp {
  flex: 1;
  height: 76rpx;
  margin: 0 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #0F2350;
  background: #F8FAFC;
  border-radius: 22rpx;
}

/* 二维码面板（P3-㉘） */
.qr-box {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 4rpx;
}
.qr-canvas { width: 440rpx; height: 440rpx; }
.qr-tip { font-size: 23rpx; color: #94A3B8; text-align: center; margin-bottom: 28rpx; }
