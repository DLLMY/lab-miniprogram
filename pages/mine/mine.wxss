/* 我的页面样式 */
.wk-hero { padding: 44rpx 32rpx 40rpx; }
.wk-av {
  width: 108rpx; height: 108rpx;
  border-radius: 32rpx;
  font-size: 42rpx;
  margin-right: 24rpx;
}
.wk-id { min-width: 0; }
.wk-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}
.wk-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .50);
  margin-top: 8rpx;
}

/* 数据来源状态条 */
.wk-src {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 16rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .06);
  border: 1rpx solid rgba(255, 255, 255, .10);
}
.ws-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.ws-dot.ok { background: #34D399; box-shadow: 0 0 12rpx rgba(52, 211, 153, .8); }
.ws-dot.warn { background: #FBBF24; box-shadow: 0 0 12rpx rgba(251, 191, 36, .8); }
.ws-t { font-size: 23rpx; color: rgba(255, 255, 255, .68); }

/* 自检结论行 */
.diag-line {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #F7F9FC;
  margin-bottom: 16rpx;
}
.dl-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  margin: 12rpx 16rpx 0 0;
  flex-shrink: 0;
}
.dl-dot.ok { background: #10B981; }
.dl-dot.warn { background: #F59E0B; }
/* token 临期等硬告警：红字，视觉上与普通 warn（黄）区分 */
.kv-warn { color: #DC2626 !important; }
/* 自检通过与云库已连接：绿字 */
.kv-ok { color: #059669 !important; font-weight: 600; }
.diag-line text {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.6;
}

/* 我的申请：驳回原因、撤回入口、逾期提示 */
.list-why {
  font-size: 22rpx;
  color: #DC2626;
  margin-top: 6rpx;
  padding: 8rpx 16rpx;
  background: rgba(239, 68, 68, .08);
  border-radius: 12rpx;
  display: inline-block;
}
.list-warn { color: #DC2626; font-weight: 600; }
.list-act {
  display: inline-block;
  margin-top: 10rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: #5A6B85;
  background: #F1F5F9;
  border-radius: 999rpx;
}
