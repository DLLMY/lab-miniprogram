/* 审批页样式 */
.ap-hero { padding: 40rpx 32rpx 44rpx; }
.ap-count {
  display: flex;
  align-items: baseline;
  margin-top: 30rpx;
}
.ap-n {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  text-shadow: 0 0 30rpx rgba(34, 211, 238, .5);
}
.ap-l {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .55);
  margin-left: 16rpx;
}

/* ===== 批量选择 ===== */
.ck {
  width: 40rpx; height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid #CBD5E1;
  background: #FFFFFF;
  flex-shrink: 0;
  margin-right: 18rpx;
  position: relative;
}
.ck.on { background: #2B6CFF; border-color: #2B6CFF; }
.ck.on::after {
  content: '';
  position: absolute;
  left: 12rpx; top: 5rpx;
  width: 12rpx; height: 22rpx;
  border-right: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(40deg);
}

/* ===== 驳回原因弹层（与详情页同规格） ===== */
