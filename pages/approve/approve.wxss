/* 审批页样式 */
.ap-hero { padding: 40rpx 32rpx 44rpx; }
.ap-count {
  display: flex;
  align-items: baseline;
  margin-top: 30rpx;
}
.ap-n {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  text-shadow: 0 0 30rpx rgba(34, 211, 238, .5);
}
.ap-l {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .55);
  margin-left: 16rpx;
}

/* ===== 批量选择 ===== */
.ck {
  width: 40rpx; height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid #CBD5E1;
  background: #FFFFFF;
  flex-shrink: 0;
  margin-right: 18rpx;
  position: relative;
}
.ck.on { background: #2B6CFF; border-color: #2B6CFF; }
.ck.on::after {
  content: '';
  position: absolute;
  left: 12rpx; top: 5rpx;
  width: 12rpx; height: 22rpx;
  border-right: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(40deg);
}
.btn-sm {
  padding: 0 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 600;
}
.btn-sm.primary { background: rgba(43, 108, 255, .12); color: #2B6CFF; }
.btn-sm.off { background: #F1F5F9; color: #94A3B8; }

/* ===== 驳回原因弹层（与详情页同规格） ===== */
.ap-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(9, 20, 45, .45);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}
.ap-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.ap-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.ap-title { flex: 1; font-size: 34rpx; font-weight: 700; color: #0F2350; }
.ap-close {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F1F5F9; border-radius: 50%;
}
.ap-close image { width: 26rpx; height: 26rpx; opacity: .55; }
.ap-sub { font-size: 24rpx; color: #94A3B8; margin-bottom: 32rpx; }
.ap-tags { display: flex; flex-wrap: wrap; margin: 0 -8rpx 18rpx; }
.ap-tag {
  margin: 0 8rpx 14rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #5A6B85;
  background: #F1F5F9;
  border-radius: 999rpx;
}
.ap-tag.on { background: rgba(43, 108, 255, .12); color: #2B6CFF; font-weight: 600; }
