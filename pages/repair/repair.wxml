<view class="page" wx:if="{{!denied}}">

  <view class="sec">
    <view class="sec-bar"></view>
    <view class="sec-t">报修管理</view>
    <view class="sec-x">{{list.length}} 条</view>
  </view>

  <!-- 筛选 + 新增 -->
  <view class="row" style="gap:16rpx;margin-bottom:24rpx;flex-wrap:wrap;">
    <picker mode="selector" range="{{labLabels}}" value="{{labIndex}}" bindchange="onFilterLab" class="grow">
      <view class="picker-inp">{{labLabels[labIndex] || '全部实训室'}}<image class="list-arrow" src="/images/ic-chevron-s.png" mode="aspectFit" /></view>
    </picker>
    <picker mode="selector" range="{{statusLabels}}" value="{{filterStatusIndex}}" bindchange="onFilterStatus" class="grow">
      <view class="picker-inp">{{filterStatus}}<image class="list-arrow" src="/images/ic-chevron-s.png" mode="aspectFit" /></view>
    </picker>
    <button class="btn btn-primary btn-sm" style="flex-shrink:0" bindtap="openAdd">+ 报修</button>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length===0}}" class="empty">
    <view>暂无报修记录</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card card-tight">
    <view class="row-between">
      <view class="row">
        <text class="list-nm">{{item.title}}</text>
        <text class="pill {{item.status==='待处理'?'warn':item.status==='处理中'?'blue':item.status==='已完成'?'ok':'grey'}}">{{item.status}}</text>
      </view>
      <text class="pill {{item.priority==='紧急'?'red':item.priority==='一般'?'blue':'grey'}}">{{item.priority}}</text>
    </view>
    <view class="list-sub mt-s">归属：{{item.labName}}{{item.labDeleted ? '（实训室已删除）' : '（'+item.labId+'）'}} · {{item.category}}</view>
    <view class="list-sub">报修人：{{item.reporterName||'—'}} · {{item.reporterId}}</view>
    <view wx:if="{{item.desc}}" class="list-sub">描述：{{item.desc}}</view>
    <view wx:if="{{item.status!=='待处理'}}" class="list-sub">处理人：{{item.handlerName||'—'}} · 结果：{{item.resolvedNote||'—'}}</view>
    <button wx:if="{{item.status!=='已完成' && item.status!=='已取消'}}" class="btn btn-ghost btn-sm mt-m" data-item="{{item}}" bindtap="openProcess">处理 / 关闭</button>
  </view>

</view>

<!-- 新增报修 -->
<view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
  <view class="sheet" catchtap="noop">
    <view class="title">新增报修</view>
    <view class="field">
      <view class="field-l">归属实训室 <text class="muted">(必选)</text></view>
      <picker mode="selector" range="{{labLabels}}" value="{{labIndex}}" bindchange="onLab">
        <view class="picker-inp">{{labLabels[labIndex] || '请选择实训室'}}<image class="list-arrow" src="/images/ic-chevron-s.png" mode="aspectFit" /></view>
      </picker>
    </view>
    <view class="field">
      <view class="field-l">报修内容 <text class="muted">(必填)</text></view>
      <input class="inp" value="{{form.title}}" placeholder="请输入报修内容" bindinput="onTitle" />
    </view>
    <view class="row" style="gap:16rpx">
      <view class="field grow">
        <view class="field-l">类别</view>
        <picker mode="selector" range="{{catLabels}}" value="{{catIndex}}" bindchange="onCat">
          <view class="picker-inp">{{catLabels[catIndex]}}<image class="list-arrow" src="/images/ic-chevron-s.png" mode="aspectFit" /></view>
        </picker>
      </view>
      <view class="field grow">
        <view class="field-l">紧急程度</view>
        <picker mode="selector" range="{{priLabels}}" value="{{priIndex}}" bindchange="onPri">
          <view class="picker-inp">{{priLabels[priIndex]}}<image class="list-arrow" src="/images/ic-chevron-s.png" mode="aspectFit" /></view>
        </picker>
      </view>
    </view>
    <view class="field">
      <view class="field-l">详细描述</view>
      <input class="inp" value="{{form.desc}}" placeholder="选填，描述故障现象" bindinput="onDesc" />
    </view>
    <view class="btn-row mt-m">
      <view class="btn-cell"><button class="btn btn-ghost" bindtap="closeForm">取消</button></view>
      <view class="btn-cell"><button class="btn btn-primary" bindtap="save">提交</button></view>
    </view>
  </view>
</view>

<!-- 处理 / 关闭 -->
<view wx:if="{{showProcess}}" class="mask" bindtap="closeProcess">
  <view class="sheet" catchtap="noop">
    <view class="title">处理：{{processing.title}}</view>
    <view class="field">
      <view class="field-l">处理状态</view>
      <picker mode="selector" range="{{procStatusLabels}}" value="{{procStatusIndex}}" bindchange="onProcStatus">
        <view class="picker-inp">{{procStatusLabels[procStatusIndex]}}<image class="list-arrow" src="/images/ic-chevron-s.png" mode="aspectFit" /></view>
      </picker>
    </view>
    <view class="field">
      <view class="field-l">处理说明 / 结果</view>
      <input class="inp" value="{{procForm.resolvedNote}}" placeholder="请输入处理说明" bindinput="onResolvedNote" />
    </view>
    <view class="btn-row mt-m">
      <view class="btn-cell"><button class="btn btn-ghost" bindtap="closeProcess">取消</button></view>
      <view class="btn-cell"><button class="btn btn-primary" bindtap="saveProcess">保存</button></view>
    </view>
  </view>
</view>

<view wx:if="{{denied}}" class="guard">
  <image class="guard-ic" src="/images/ic-shield-w.png" mode="aspectFit"></image>
  <view class="guard-t">仅教师 / 管理员可访问</view>
  <view class="guard-s">报修管理由教师发起与处理，请用教师或管理员账号登录。</view>
</view>
