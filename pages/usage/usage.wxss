/* 使用概况页样式 */
.us-hero { padding: 40rpx 32rpx 44rpx; }
.us-total {
  margin-top: 30rpx;
}
.us-n {
  font-size: 76rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  letter-spacing: 2rpx;
  text-shadow: 0 0 34rpx rgba(34, 211, 238, .45);
}
.us-l {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .55);
  margin-top: 12rpx;
}

/* 排行榜行 */
.rk {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F3F8;
}
.rk:last-child { border-bottom: none; }
.rk-no {
  width: 52rpx; height: 52rpx;
  border-radius: 18rpx;
  margin-right: 20rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F1F5F9;
  color: #64748B;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.rk-no.top {
  background: linear-gradient(135deg, #22D3EE 0%, #2B6CFF 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(43, 108, 255, .26);
}
.rk-n {
  font-size: 26rpx;
  font-weight: 700;
  color: #2B6CFF;
}
.rk-role {
  font-size: 22rpx;
  color: #8A99AF;
}

/* ===== 报表：趋势柱状图（P2-㉓） ===== */
.chart {
  display: flex;
  align-items: flex-end;
  height: 220rpx;
  padding: 12rpx 0 0;
  gap: 10rpx;
}
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.chart-bars {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
}
.chart-bar {
  width: 22rpx;
  min-height: 4rpx;
  border-radius: 8rpx 8rpx 0 0;
}
.chart-bar.in { background: linear-gradient(180deg, #22D3EE 0%, #0891B2 100%); }
.chart-bar.out { background: linear-gradient(180deg, #F87171 0%, #DC2626 100%); }
.chart-l { font-size: 20rpx; color: #94A3B8; margin-top: 10rpx; }
.chart-legend { display: flex; justify-content: center; gap: 32rpx; margin-top: 16rpx; }
.lg { display: flex; align-items: center; font-size: 22rpx; color: #5A6B85; }
.lg-dot { width: 18rpx; height: 18rpx; border-radius: 6rpx; margin-right: 10rpx; }
.lg-dot.in { background: #22D3EE; }
.lg-dot.out { background: #F87171; }

/* 申请单构成分布 */
.dist { display: flex; text-align: center; }
.dist-i { flex: 1; }
.dist-n { font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.dist-n.warn { color: #D97706; }
.dist-n.ok { color: #059669; }
.dist-n.red { color: #DC2626; }
.dist-n.grey { color: #94A3B8; }
.dist-l { font-size: 22rpx; color: #94A3B8; margin-top: 4rpx; }

/* 借用列表右侧标签容器（避免 pill 挤压宽度） */
.row-block { flex-shrink: 0; margin-left: 16rpx; }
