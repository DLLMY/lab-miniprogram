<view class="wk">
  <!-- ===== 深空顶区 ===== -->
  <view class="hero wk-hero">
    <view class="hero-grid"></view>
    <view class="hero-inner">
      <view class="wk-hi">
        <view class="wk-hi-l">
          <view class="hero-tag">{{roleText}}</view>
          <view class="wk-greet">{{greet}}</view>
        </view>
        <view class="avatar" bindtap="switchAccount">{{meInitial}}</view>
      </view>
      <view class="hero-t">{{me ? me.name : '未登录'}}</view>
      <view class="hero-s">{{me ? me.id : '点击右上角头像登录'}} · 智慧实训空间</view>

      <view class="wk-scan" bindtap="scan">
        <image class="wk-scan-ic" src="/images/ic-qr-w.png" mode="aspectFit"></image>
        <view class="grow">
          <view class="wk-scan-t">扫描物品二维码</view>
          <view class="wk-scan-s">识别耗材 / 工具，即刻查看详情</view>
        </view>
        <image class="wk-scan-arrow" src="/images/ic-chevron-w.png" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <!-- ===== 内容区 ===== -->
  <view class="page">
    <!-- 统计瓦片 -->
    <view class="tiles">
      <view class="tile tile-blue">
        <view class="tile-n">{{matCount}}</view>
        <view class="tile-l">耗材品类</view>
      </view>
      <view class="tile tile-cyan">
        <view class="tile-n">{{toolCount}}</view>
        <view class="tile-l">在册工具</view>
      </view>
      <view class="tile tile-amber">
        <view class="tile-n">{{pendingCount}}</view>
        <view class="tile-l">待办审批</view>
      </view>
    </view>

    <!-- 快捷搜索（模糊匹配 + 实时下拉建议） -->
    <view class="search-wrap mt-m">
      <view class="search">
        <image src="/images/ic-search-s.png" mode="aspectFit"></image>
        <input placeholder="搜索名称 / 规格 / 编码" placeholder-class="search-ph" value="{{qid}}" bindinput="onSearch" bindfocus="onFocus" bindconfirm="go" confirm-type="search" />
        <view wx:if="{{qid}}" class="search-clear" catchtap="clearSearch">✕</view>
        <view wx:else class="search-go" bindtap="go">查询</view>
      </view>
      <!-- 候选下拉：锚定在搜索框下方；点击候选直达详情 -->
      <view wx:if="{{showSuggest}}" class="suggest">
        <view wx:if="{{suggest.length===0}}" class="suggest-empty">未找到匹配的物品</view>
        <view wx:for="{{suggest}}" wx:key="id" class="suggest-item" catchtap="pickItem" data-id="{{item.id}}">
          <view class="suggest-ic {{item.type==='tool'?'tool':'mat'}}">{{item.type==='tool'?'工':'耗'}}</view>
          <view class="grow">
            <view class="suggest-nm">{{item.name}}</view>
            <view class="suggest-sub">{{item.id}} · {{item.sub}}</view>
          </view>
          <text class="suggest-tag">{{item.type==='tool'?(item.status||''):('库存 '+item.stock)}}</text>
        </view>
      </view>
    </view>
    <!-- 点击空白处收起下拉 -->
    <view wx:if="{{showSuggest}}" class="suggest-mask" catchtap="closeSuggest"></view>

    <!-- 库存预警（P2-⑳）：教师不看库存页也要知道缺什么了 -->
    <view wx:if="{{isStaff && lowCount}}" class="card card-accent warn-card mt-m" bindtap="goInventory">
      <view class="row-between">
        <view class="row">
          <view class="list-ic"><image src="/images/ic-alert-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="list-nm">{{lowCount}} 项耗材低于安全库存</view>
            <view class="list-sub" wx:for="{{lowList}}" wx:key="id">{{item.name}} 剩 {{item.stock}}{{item.unit}}（下限 {{item.safe}}）</view>
          </view>
        </view>
        <view class="pill red">需补货</view>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="sec mt-l">
      <view class="sec-bar"></view>
      <view class="sec-t">功能导航</view>
      <view class="sec-x">Functional Modules</view>
    </view>
    <view class="grid">
      <view class="grid-i">
        <view class="grid-c" data-url="/pages/inventory/inventory" bindtap="goStaff">
          <view class="grid-ic"><image src="/images/ic-box-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">库存一览</view>
            <view class="grid-s">耗材与工具状态</view>
          </view>
        </view>
      </view>
      <view wx:if="{{isStaff}}" class="grid-i">
        <view class="grid-c" data-url="/pages/approve/approve" bindtap="goStaff">
          <view class="grid-ic"><image src="/images/ic-clipboard-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">领用审批</view>
            <view class="grid-s">处理学生申请</view>
          </view>
        </view>
      </view>
      <view wx:if="{{isStaff}}" class="grid-i">
        <view class="grid-c" data-url="/pages/io/io" bindtap="goStaff">
          <view class="grid-ic"><image src="/images/ic-swap-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">出入库登记</view>
            <view class="grid-s">入库出库与库存</view>
          </view>
        </view>
      </view>
      <view wx:if="{{isStaff}}" class="grid-i">
        <view class="grid-c" data-url="/pages/io/io?tab=new" bindtap="goNewItem">
          <view class="grid-ic"><image src="/images/ic-plus-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">物品入库</view>
            <view class="grid-s">新物品建档入库</view>
          </view>
        </view>
      </view>
      <view wx:if="{{isStaff}}" class="grid-i">
        <view class="grid-c" data-url="/pages/usage/usage" bindtap="goStaff">
          <view class="grid-ic"><image src="/images/ic-chart-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">使用概况</view>
            <view class="grid-s">操作统计与活跃度</view>
          </view>
        </view>
      </view>
      <view wx:if="{{isStaff}}" class="grid-i">
        <view class="grid-c" data-url="/pages/labs/labs" bindtap="goStaff">
          <view class="grid-ic"><image src="/images/ic-box-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">实训室管理</view>
            <view class="grid-s">位置 / 负责人 / 归属</view>
          </view>
        </view>
      </view>
      <view wx:if="{{isStaff}}" class="grid-i">
        <view class="grid-c" data-url="/pages/repair/repair" bindtap="goStaff">
          <view class="grid-ic"><image src="/images/ic-tool-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">报修管理</view>
            <view class="grid-s">归属实训室的报修</view>
          </view>
        </view>
      </view>
      <view wx:if="{{isStaff}}" class="grid-i">
        <view class="grid-c" data-url="/pages/inspection/inspection" bindtap="goStaff">
          <view class="grid-ic"><image src="/images/ic-search-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">巡检管理</view>
            <view class="grid-s">归属实训室的巡检</view>
          </view>
        </view>
      </view>
      <view class="grid-i">
        <view class="grid-c" bindtap="switchAccount">
          <view class="grid-ic"><image src="/images/ic-users-b.png" mode="aspectFit"></image></view>
          <view class="grow">
            <view class="grid-t">切换账号</view>
            <view class="grid-s">重新绑定身份</view>
          </view>
        </view>
      </view>
    </view>

  </view>

  <!-- ===== 新手引导（P3-㉙）=====
       首次进入按角色给一次操作指引；关闭后写入本地标记，之后不再出现。 -->
  <view wx:if="{{showGuide}}" class="ap-mask">
    <view class="ap-panel" catchtap="noop">
      <view class="ap-head">
        <view class="ap-title">{{guideTitle}}</view>
      </view>
      <view class="ap-sub">按你当前的权限，常用操作如下：</view>
      <view wx:for="{{guideSteps}}" wx:key="*this" class="gd-step">{{item}}</view>
      <button class="btn btn-primary btn-block mt-m" bindtap="closeGuide">我知道了</button>
    </view>
  </view>
</view>
