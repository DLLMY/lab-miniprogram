/* 库存一览页样式 */
.iv-hero { padding: 40rpx 32rpx 44rpx; }
.iv-counts {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}
.iv-c { flex: 1; }
.iv-n {
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
}
.iv-l {
  font-size: 22rpx;
  color: rgba(255, 255, 255, .50);
  margin-top: 8rpx;
}
.iv-div {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, .16);
  margin: 0 24rpx;
}

/* 右侧数量 */
.iv-qty {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.iv-qn {
  font-size: 36rpx;
  font-weight: 700;
  color: #0D1526;
  line-height: 1.1;
}
.iv-qu {
  font-size: 21rpx;
  color: #8A99AF;
  margin-top: 4rpx;
}
.iv-qty.low .iv-qn { color: #DC2626; }
