/* 库存一览页样式 */
.iv-hero { padding: 40rpx 32rpx 44rpx; }
.iv-counts {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}
.iv-c { flex: 1; }
.iv-n {
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
}
.iv-l {
  font-size: 22rpx;
  color: rgba(255, 255, 255, .50);
  margin-top: 8rpx;
}
.iv-div {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, .16);
  margin: 0 24rpx;
}

/* 搜索下拉建议（与首页同规格，保持手感一致） */

/* 快捷出入库（P2-⑯） */
.iv-acts { display: flex; gap: 12rpx; margin-top: 14rpx; }
.iv-act {
  padding: 6rpx 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
}
.iv-act.in { color: #0891B2; background: rgba(6, 182, 212, .12); }
.iv-act.out { color: #DC2626; background: rgba(239, 68, 68, .10); }

/* 效期提示（P3-㉕） */
/* 批量建档弹层 */
.iv-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 16, 32, .45); display: flex; align-items: flex-end; z-index: 50;
}
.iv-sheet {
  width: 100%; background: #FFFFFF; border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.iv-close { font-size: 30rpx; color: #94A3B8; padding: 0 12rpx; }
.iv-area {
  width: 100%; height: 420rpx; box-sizing: border-box; margin: 18rpx 0;
  padding: 20rpx; border: 2rpx solid #DCE3EE; border-radius: 16rpx;
  font-size: 24rpx; color: #1E293B; line-height: 1.6;
}
/* 补货入库行：勾选框 + 名称 + 数量输入 */
.rp-row {
  display: flex; align-items: center; padding: 18rpx 4rpx;
  border-bottom: 2rpx solid #F1F5F9;
}
.rp-row .ck {
  width: 36rpx; height: 36rpx; border: 3rpx solid #CBD5E1; border-radius: 10rpx;
  margin-right: 18rpx; flex-shrink: 0;
}
.rp-row .ck.on { background: #2B6CFF; border-color: #2B6CFF; position: relative; }
.rp-row .ck.on::after {
  content: ''; position: absolute; left: 9rpx; top: 3rpx; width: 10rpx; height: 18rpx;
  border: solid #FFFFFF; border-width: 0 4rpx 4rpx 0; transform: rotate(45deg);
}
.rp-qty { flex-shrink: 0; margin-left: 16rpx; text-align: center; }
.rp-inp {
  width: 128rpx; height: 64rpx; box-sizing: border-box; text-align: center;
  border: 2rpx solid #DCE3EE; border-radius: 12rpx; font-size: 26rpx; color: #1E293B;
}

/* 工具行右侧：状态徽章 + 行内操作按钮（借出/归还）纵向排列 */
.col-end {
  display: flex; flex-direction: column; align-items: flex-end;
  flex-shrink: 0; margin-left: 16rpx;
}
