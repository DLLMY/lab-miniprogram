/* 登录页：全屏深空科技风 */
.login-page {
  position: relative;
  min-height: 100vh;
  padding: 80rpx 40rpx 80rpx;
  background: linear-gradient(160deg, #080D1A 0%, #101F3F 45%, #0A1424 100%);
  overflow: hidden;
}
.login-page::before {
  content: '';
  position: absolute;
  top: -200rpx; right: -160rpx;
  width: 560rpx; height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 211, 238, .30) 0%, rgba(34, 211, 238, 0) 68%);
}
.login-page::after {
  content: '';
  position: absolute;
  bottom: -240rpx; left: -180rpx;
  width: 620rpx; height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(43, 108, 255, .32) 0%, rgba(43, 108, 255, 0) 70%);
}

.login-brand {
  position: relative;
  z-index: 2;
  text-align: center;
  margin-bottom: 56rpx;
}
.logo {
  width: 132rpx; height: 132rpx;
  margin: 0 auto 28rpx;
  border-radius: 38rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(43, 108, 255, .22) 0%, rgba(34, 211, 238, .22) 100%);
  border: 1rpx solid rgba(255, 255, 255, .16);
  box-shadow: 0 16rpx 44rpx rgba(34, 211, 238, .22);
}
.logo image { width: 66rpx; height: 66rpx; }
.login-t {
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 3rpx;
}
.login-s {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .46);
  margin-top: 14rpx;
  letter-spacing: 1rpx;
}

/* 玻璃卡 */
.login-card {
  position: relative;
  z-index: 2;
  background: rgba(255, 255, 255, .06);
  border: 1rpx solid rgba(255, 255, 255, .13);
  border-radius: 36rpx;
  padding: 44rpx 36rpx 36rpx;
}
.lc-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}
.lc-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, .48);
  margin: 12rpx 0 36rpx;
}
.login-card .field-l { color: rgba(255, 255, 255, .62); }
.login-card .inp {
  background: rgba(255, 255, 255, .07);
  border: 2rpx solid rgba(255, 255, 255, .13);
  color: #FFFFFF;
}
.inp-ph { color: rgba(255, 255, 255, .30); }
.login-card .btn-primary {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #22D3EE 0%, #2B6CFF 100%);
  box-shadow: 0 14rpx 34rpx rgba(43, 108, 255, .38);
}
.lc-note {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .09);
}
.lc-note image { width: 30rpx; height: 30rpx; margin-right: 14rpx; flex-shrink: 0; opacity: .7; }
.lc-note text { font-size: 22rpx; color: rgba(255, 255, 255, .40); line-height: 1.7; }
