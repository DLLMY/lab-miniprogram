<view class="login-page">
  <view class="hero-grid"></view>

  <view class="login-brand">
    <view class="logo">
      <image src="/images/ic-bolt-c.png" mode="aspectFit"></image>
    </view>
    <view class="login-t">实训室管理系统</view>
    <view class="login-s">Lab Management · 智慧实训空间</view>
  </view>

  <block wx:if="{{autoJumping}}">
    <view class="login-card">
      <view class="lc-title">正在进入…</view>
      <view class="lc-sub">已检测到登录状态，正在跳转工作台</view>
    </view>
  </block>
  <block wx:else>
    <view class="login-card">
      <view class="lc-title">绑定身份</view>
      <view class="lc-sub">首次使用请绑定微信，之后免输入直接进入</view>

      <view class="field">
        <view class="field-l">姓名</view>
        <input class="inp" placeholder="请输入真实姓名" placeholder-class="inp-ph" value="{{name}}" bindinput="nameInput" />
      </view>
      <view class="field">
        <view class="field-l">工号</view>
        <input class="inp" placeholder="请输入工号" placeholder-class="inp-ph" value="{{id}}" bindinput="idInput" />
      </view>

      <button class="btn btn-primary btn-block" bindtap="submit" disabled="{{busy}}">
        {{busy ? '绑定中…' : '绑定并登录'}}
      </button>

      <view class="lc-note">
        <image src="/images/ic-shield-s.png" mode="aspectFit"></image>
        <text>姓名与工号需与学校登记信息一致；一个工号仅可绑定一个微信，一个微信仅可绑定一个工号。</text>
      </view>
    </view>
  </block>
</view>
