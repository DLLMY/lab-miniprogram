/* 隐私说明页：与全站浅色卡片风一致 */
.hero {
  position: relative;
  padding: 56rpx 32rpx 48rpx;
  background: linear-gradient(160deg, #080D1A 0%, #101F3F 55%, #0A1424 100%);
  overflow: hidden;
}
.hero-grid {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(255,255,255,.04) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(255,255,255,.04) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}
.hero-in { position: relative; z-index: 2; text-align: center; }
.hero-ic {
  width: 88rpx; height: 88rpx; margin: 0 auto 20rpx;
  border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(34, 211, 238, .14);
  border: 1rpx solid rgba(255,255,255,.16);
}
.hero-ic image { width: 46rpx; height: 46rpx; }
.hero-t { font-size: 40rpx; font-weight: 700; color: #FFFFFF; letter-spacing: 2rpx; }
.hero-s { font-size: 24rpx; color: rgba(255,255,255,.48); margin-top: 12rpx; }

.page { padding: 32rpx 28rpx 60rpx; }
.lead {
  font-size: 26rpx; color: #475569; line-height: 1.75;
  padding: 24rpx; background: #FFFFFF; border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(15,23,42,.05);
}

.sec { display: flex; align-items: center; margin: 36rpx 4rpx 16rpx; }
.sec.mt { margin-top: 44rpx; }
.sec-bar { width: 6rpx; height: 30rpx; border-radius: 4rpx; background: #2B6CFF; margin-right: 14rpx; }
.card {
  background: #FFFFFF; border-radius: 24rpx; padding: 12rpx 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(15,23,42,.05);
}

.row {
  display: flex; align-items: flex-start;
  padding: 20rpx 0; border-bottom: 1rpx solid #EEF2F7;
}
.row:last-child { border-bottom: none; }
.rn { width: 150rpx; flex-shrink: 0; font-size: 26rpx; font-weight: 600; color: #0F172A; }
.rv { flex: 1; font-size: 25rpx; color: #475569; line-height: 1.65; }

.li {
  position: relative; padding: 16rpx 0 16rpx 32rpx;
  font-size: 26rpx; color: #334155; line-height: 1.65;
  border-bottom: 1rpx solid #F1F5F9;
}
.li:last-child { border-bottom: none; }
.li::before {
  content: ''; position: absolute; left: 6rpx; top: 30rpx;
  width: 10rpx; height: 10rpx; border-radius: 50%; background: #2B6CFF;
}
.li.no::before { background: #10B981; }

.tipbox {
  margin: 14rpx 0 18rpx; padding: 18rpx 20rpx;
  font-size: 23rpx; color: #5A6B85; line-height: 1.7;
  background: #F1F5FB; border-radius: 14rpx;
}

.foot { text-align: center; font-size: 23rpx; color: #94A3B8; margin-top: 48rpx; }
.foot.sub { margin-top: 10rpx; font-size: 21rpx; color: #B4C0D0; }
